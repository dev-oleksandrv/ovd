{
  "name": "ovd-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cli": "pnpm --filter @ovd/cli dev",
    "gui": "pnpm --filter @ovd/gui dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run test:e2e:cli && pnpm run test:e2e:gui",
    "test:e2e:cli": "pnpm --filter @ovd/cli build && pnpm --filter @ovd/e2e test:cli",
    "test:e2e:gui": "pnpm --filter @ovd/cli --filter @ovd/gui build && pnpm --filter @ovd/e2e test:gui",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.6.0"
}
